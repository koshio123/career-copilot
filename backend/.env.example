# Copy to backend/.env for local development. Never commit the real .env.
# All variables are prefixed APP_ and read by app/core/config.py.

APP_ENV=local
APP_DEBUG=true

# Local Postgres from docker-compose (host port 5433).
APP_DATABASE_URL=postgresql+asyncpg://career:career@localhost:5433/career_copilot

# Logging
APP_LOG_LEVEL=INFO
APP_LOG_JSON=false

# AWS / LocalStack (DynamoDB for auth; SQS/S3 from Phase 04).
APP_AWS_REGION=ap-northeast-1
APP_AWS_ENDPOINT_URL=http://localhost:4566

# Auth (ADR-0010)
APP_SECRET_KEY=dev-only-change-me
APP_DYNAMODB_TABLE_PREFIX=career-copilot-local
APP_SESSION_COOKIE_SECURE=false

# Email — "console" logs the code, "smtp" sends to MailHog (see it at :8025)
APP_EMAIL_BACKEND=console
APP_SMTP_HOST=localhost
APP_SMTP_PORT=1025

# Async workers (Phase 04). Local queues are created in LocalStack by the worker;
# set these only to point at real SQS.
# APP_SQS_DEFAULT_QUEUE_URL=
# APP_SQS_BROWSER_QUEUE_URL=

# LLM (Phase 04). Unset locally unless you're actually calling Claude.
# APP_ANTHROPIC_API_KEY=
APP_LLM_MODEL=claude-sonnet-5
